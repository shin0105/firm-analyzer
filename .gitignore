# Secrets: copy .env.example to .env and fill it in. Never commit .env.
.env
.env.*
!.env.example

# Runtime-mutable config (the web UI writes it). Ship config.example.yml instead.
config.yml
config.json

# Pipeline output. Generated per user, and contains scraped web pages and
# AI-written text about real companies, so it is never published.
firm_results/
data/filtered_firms.csv
data/geocode_cache.json
data/archive/
data/uploads/
data/test_*.csv
data/*_parsed.csv
data/*_parsed_extended*.csv

