# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.

# --- Search & LLM ---------------------------------------------------------
# Tavily search API key: https://app.tavily.com/
TAVILY_API_KEY=

# GitHub token, used as the API key for GitHub Models inference.
# Needs the `models:read` scope. https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenAI-compatible endpoint used for summarization.
# Defaults to GitHub Models if unset.
OPENAI_BASE_URL=https://models.github.ai/inference

# Only needed for the LLM PDF parser (scripts/run_pdf_parser_llm.py).
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Maps & geocoding -----------------------------------------------------
# Kakao JavaScript key, injected into the map view.
# NOTE: this key is served to the browser and is therefore public by design.
# Restrict it to your own domains in the Kakao developer console.
KAKAO_JS_API_KEY=

# Kakao REST key, used for server-side geocoding. Keep this one secret.
KAKAO_REST_API_KEY=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
# The anon/publishable key. It is exposed to clients by design, so the table's
# Row Level Security policies are what actually protect your data — make sure
# RLS is enabled on the `firms` table before going public.
SUPABASE_KEY=
SUPABASE_PW=

# --- Flask ----------------------------------------------------------------
# Never enable debug mode on a host reachable from the network.
FLASK_DEBUG=false
FILTER_SCRIPT_TIMEOUT=60
SUMMARIZE_SCRIPT_TIMEOUT=300
DRY_RUN_TIMEOUT=60

# --- Model overrides (optional) -------------------------------------------
# Both parsers default to a sensible model; override if the default is
# unavailable on your account.
GEMINI_PARSER_MODEL=gemini-3.1-flash-lite
OPENAI_PARSER_MODEL=gpt-5-mini

# --- Web server -----------------------------------------------------------
# Loopback by default. Only widen this deliberately; the API is unauthenticated.
FLASK_HOST=127.0.0.1
FLASK_PORT=8001
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=33554432

# Override the project root when running the installed package from elsewhere.
# FIRM_ANALYZER_HOME=/path/to/firm_websearch
