# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.

# --- Search ---------------------------------------------------------------
# Tavily search API key: https://app.tavily.com/
TAVILY_API_KEY=

# --- LLM provider ---------------------------------------------------------
# Which AI runs the summaries, the segmentation and the PDF parser.
# One of: openai | claude | gemini | github
# This overrides `app.llm_provider` in config.yml; `--provider` on the CLIs
# overrides both. You only need the key for the provider you actually select.
LLM_PROVIDER=openai

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude / Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub Models (OpenAI-compatible, legacy back end for this project).
# Needs the `models:read` scope. https://github.com/settings/tokens
# Note: GitHub Models is being retired, so prefer one of the three above.
GITHUB_TOKEN=
# Endpoint used by the `github` provider only.
OPENAI_BASE_URL=https://models.github.ai/inference

# --- Maps & geocoding -----------------------------------------------------
# Kakao JavaScript key, injected into the map view.
# NOTE: this key is served to the browser and is therefore public by design.
# Restrict it to your own domains in the Kakao developer console.
KAKAO_JS_API_KEY=

# Kakao REST key, used for server-side geocoding. Keep this one secret.
KAKAO_REST_API_KEY=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
# The anon/publishable key. It is exposed to clients by design, so the table's
# Row Level Security policies are what actually protect your data — make sure
# RLS is enabled on the `firms` table before going public.
SUPABASE_KEY=
SUPABASE_PW=

# --- Flask ----------------------------------------------------------------
# Never enable debug mode on a host reachable from the network.
FLASK_DEBUG=false
# Timeouts for the synchronous /api/run/* endpoints.
FILTER_SCRIPT_TIMEOUT=60
SUMMARIZE_SCRIPT_TIMEOUT=300
DRY_RUN_TIMEOUT=60
# Background jobs (Pipeline page). 0 = no time limit: a full run can take hours.
JOB_TIMEOUT_SECONDS=0
JOB_LOG_LINES=5000

# --- Model overrides (optional) -------------------------------------------
# Every provider has a built-in default. <PROVIDER>_MODEL sets the model used
# for summaries and segmentation; <PROVIDER>_PARSER_MODEL sets the one used for
# PDF parsing (a cheaper model is usually enough there).
# Defaults: openai gpt-5 / gpt-5-mini, claude claude-opus-5,
#           gemini gemini-3.1-flash-lite, github gpt-4o.
# OPENAI_MODEL=gpt-5
# OPENAI_PARSER_MODEL=gpt-5-mini
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_PARSER_MODEL=claude-opus-5
# Gemini's free tier allows only 20 requests/day on gemini-3.5-flash, so the
# default is flash-lite. Switch up for finer judgement on ambiguous firms.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_PARSER_MODEL=gemini-3.1-flash-lite

# --- Batch tuning (optional) ----------------------------------------------
# Pages sent per PDF extraction request. Lower it if the model runs out of
# output tokens on very dense tables.
# PDF_PAGES_PER_CHUNK=6

# --- Web server -----------------------------------------------------------
# Loopback by default. Only widen this deliberately; the API is unauthenticated.
FLASK_HOST=127.0.0.1
FLASK_PORT=8001
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=33554432

# Override the project root when running the installed package from elsewhere.
# FIRM_ANALYZER_HOME=/path/to/firm_websearch
