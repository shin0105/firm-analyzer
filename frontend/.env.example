# Copy to `frontend/.env` (or `.env.local`) to point the UI at a different backend.
# Defaults to http://localhost:8001, which is where `firm-app` listens.
#
# This value is baked into the production bundle at build time and is visible
# to anyone using the site, so never put a secret here.
VITE_API_BASE_URL=http://localhost:8001
