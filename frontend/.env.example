# Leave unset in normal use: the built app is served by Flask on the same
# origin, and `npm run dev` proxies /api, /map and /static to Flask.
# Set this only when the API is served from a different origin, and add this
# app's origin to CORS_ORIGINS on the server.
# VITE_API_BASE=https://api.example.com

# Where `npm run dev` forwards API requests (default http://127.0.0.1:8001).
# VITE_BACKEND_URL=http://127.0.0.1:8001
